{
  "name": "satvis",
  "version": "1.0.0",
  "private": true,
  "description": "Satellite orbit visualization with CesiumJS",
  "license": "MIT",
  "author": "Florian Mauracher",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "dev:worker": "pnpm --filter satvis-worker dev",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "lint": "pnpm lint:web && pnpm lint:worker",
    "lint:web": "oxlint && oxfmt --check && vue-tsc",
    "lint:worker": "pnpm --filter satvis-worker lint",
    "lint:fix": "pnpm lint:fix:web && pnpm lint:fix:worker",
    "lint:fix:web": "oxlint --fix && oxfmt --write",
    "lint:fix:worker": "pnpm --filter satvis-worker lint:fix",
    "update-tle": "node data/tle/update-tle.js",
    "update-custom-data": "pnpm update-tle && bash data/custom/update-custom-data.sh",
    "deploy": "pnpm build && pnpm --filter satvis-worker deploy"
  },
  "dependencies": {
    "@cesium/engine": "^26.0.0",
    "@cesium/widgets": "^16.0.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.0",
    "@fortawesome/free-brands-svg-icons": "^7.3.0",
    "@fortawesome/free-solid-svg-icons": "^7.3.0",
    "@fortawesome/vue-fontawesome": "^3.3.0",
    "@primeuix/themes": "^2.0.3",
    "cesium": "^1.142.0",
    "cesium-sensor-volumes": "github:Flowm/cesium-sensor-volumes#1.140.0",
    "dayjs": "^1.11.21",
    "pinia": "^3.0.4",
    "posthog-js": "^1.395.0",
    "primevue": "^4.5.5",
    "satellite.js": "^7.0.1",
    "vue": "^3.5.39",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vite": "8.0.16",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vue-tsc": "^3.3.5"
  },
  "packageManager": "pnpm@11.9.0"
}
