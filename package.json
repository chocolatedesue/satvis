{
  "name": "satvis",
  "version": "1.0.0",
  "description": "Satellite orbit visualization with CesiumJS",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "clean": "rimraf dist",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src && prettier --check \"src/**/*.{js,ts,vue}\"",
    "lint:fix": "eslint --fix src && prettier --write \"src/**/*.{js,ts,vue}\"",
    "serve": "npm run build && npm run preview",
    "start": "vite",
    "start:anyhost": "vite --host 0.0.0.0",
    "update-tle": "node data/tle/update-tle.js",
    "update-custom-data": "npm run update-tle && bash data/custom/update-custom-data.sh",
    "deploy": "npm run build && cd worker && npm run deploy"
  },
  "author": "Florian Mauracher",
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.1.3",
    "@primeuix/themes": "^2.0.3",
    "@sentry/browser": "^10.45.0",
    "cesium": "^1.139.1",
    "cesium-sensor-volumes": "github:Flowm/cesium-sensor-volumes#1.138.1",
    "dayjs": "^1.11.20",
    "pinia": "^3.0.4",
    "posthog-js": "^1.362.0",
    "primevue": "^4.5.4",
    "satellite.js": "^6.0.2",
    "vue": "^3.5.30",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.8.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-static-copy": "^3.3.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  }
}
