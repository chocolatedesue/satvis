{
  "name": "satvis-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for satvis",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8080",
    "lint": "oxlint && oxfmt --check && tsc --noEmit",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "generate-types": "wrangler types src/worker-configuration.d.ts",
    "type-check": "tsc"
  },
  "devDependencies": {
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.100.0"
  }
}
