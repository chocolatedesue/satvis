{
  "name": "satvis-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Cloudflare Worker backend for satvis",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev --port 8080",
    "lint": "oxlint src && oxfmt --check src && tsc --noEmit",
    "lint:fix": "oxlint --fix src && oxfmt src",
    "generate-types": "wrangler types src/worker-configuration.d.ts",
    "type-check": "tsc"
  },
  "devDependencies": {
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.1"
  }
}
