# Environment Configuration
# Copy this file to .env.development (local) and .env.production (remote)

# PostHog Configuration
VITE_POSTHOG_API_HOST=https://eu.i.posthog.com
VITE_POSTHOG_UI_HOST=https://eu.posthog.com
VITE_POSTHOG_KEY=

# Cesium ion access token, for World Terrain and the surface models.
# Optional: src/config/ion.ts carries a token restricted to satvis.space, which
# production uses and which ion rejects everywhere else. Set an unrestricted
# token here to develop those features on localhost or a preview deploy.
VITE_CESIUM_ION_TOKEN=
