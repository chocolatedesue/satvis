node_modules/
/dist/
/dev-dist/

# OS
.DS_Store

# Generated GP element-set snapshot (pnpm update-gp)
/data/gp/

# Conditional-fetch cache for the SATCAT snapshot (pnpm update-gp). Outside
# data/ because everything there is copied into the build; this is never served.
/worker/.cache/

# Nuxt UI (Vue mode) generated type declarations
/auto-imports.d.ts
/components.d.ts

report/

# Environment variables
.env
.env.*
!.env.example

# Claude Code: track the launch.json blueprint and the project skills, nothing
# else (worktrees/, settings.local.json and the rest stay ignored). The skills
# are checked in on purpose — they are repo conventions, so a clone gets them
# and a change to one is a reviewable diff (.claude/skills/README.md).
.claude/*
!.claude/launch.json
!.claude/skills/
