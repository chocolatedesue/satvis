{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev"],
      "port": 5187,
      "autoPort": true
    },
    {
      "name": "preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "preview"],
      "port": 5188,
      "autoPort": true
    },
    {
      // The real Worker against local KV, serving the built dist/ as assets.
      // Unlike `dev`/`preview` — whose /api proxy points at production — this
      // exercises the worker's own API, so run `pnpm build` first.
      "name": "worker",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "satvis-worker", "exec", "wrangler", "dev", "--port", "8788", "--test-scheduled"],
      "port": 8788,
      "autoPort": false
    }
  ]
}
